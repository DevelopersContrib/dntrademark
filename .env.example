# --- NextAuth ----------------------------------------------------------------
# Canonical URL of this site. Must match the domain users visit.
# Prod:  https://www.dntrademark.com
# Local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Random ≥32-char secret (openssl rand -base64 32)
NEXTAUTH_SECRET=

# --- Google OAuth (Cloud Console → APIs & Services → Credentials) -----------
GOOGLE_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (Settings → Developer settings → OAuth Apps) --------------
GITHUB_ID=
GITHUB_SECRET=

# --- Laravel backend (api-dntrademark) --------------------------------------
API_URL=
API_KEY=
