# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_VERCEL_URL=

# ── External APIs ────────────────────────────────────────────────────
API_URL=
API_KEY=
CONTRIB_API1=
CONTRIB_API1_TOPSITES=
CONTRIB_USERS=
RELATED_DOMAINS=

# ── Auth ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (primary) ──────────────────────────────────────────────
# Required when using direct DB queries via lib/db.ts
DB_HOST=vnocdb.example.com
DB_PORT=3306
DB_USER=app
DB_PASSWORD=
DB_NAME=vnocdb
DB_POOL_SIZE=10

# ── Database (read replica) ─────────────────────────────────────────
# SELECTs are routed here automatically.  When empty/unset, all
# queries fall back to the primary (DB_HOST).
DB_READ_HOST=vnocdb-read2.example.com
DB_READ_PORT=3306
